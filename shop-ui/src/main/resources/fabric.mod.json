{
  "schemaVersion": 1,
  "id": "shopmod-ui",
  "version": "${version}",
  "name": "Shop UI",
  "description": "Optional client screen for the server shop. Clients without this jar keep the command shop. Vanilla clients can still join.",
  "authors": ["heplus1s"],
  "contact": {
    "repo": "https://github.com/heplus1s/MinecraftUIMod"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.jdguo.shop.ui.ShopUiClient"]
  },
  "recommends": {
    "shopmod": "*"
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
}
