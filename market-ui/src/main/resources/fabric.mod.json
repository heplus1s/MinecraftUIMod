{
  "schemaVersion": 1,
  "id": "marketmod-ui",
  "version": "${version}",
  "name": "Market UI",
  "description": "Optional client screen for the player marketplace. Clients without this jar keep the command marketplace. Vanilla clients can still join.",
  "authors": ["heplus1s"],
  "contact": {
    "repo": "https://github.com/heplus1s/MinecraftUIMod"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.jdguo.market.ui.MarketUiClient"]
  },
  "recommends": {
    "marketmod": "*"
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
}
